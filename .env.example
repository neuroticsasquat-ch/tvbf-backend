DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/tvbf
TEST_DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/tvbf_test
ADMIN_TOKEN=dev-secret-change-me
# TMDB: the account's "API Read Access Token" (the long JWT) from
# https://www.themoviedb.org/settings/api — sent as `Authorization: Bearer`.
# NOT the v3 API Key; the two are not interchangeable. This file is committed,
# so the real value belongs in .env (gitignored), never here.
TMDB_READ_ACCESS_TOKEN=

# DeepInfra: the API key for the model the weekly recommendations pass calls
# (project spec §6). Sent as `Authorization: Bearer`. This file is
# committed, so the real value belongs in .env (gitignored), never here.
#
# There is no DEEPINFRA_BASE_URL — a base URL is a property of the provider, not
# of a deployment, so it is a constant in `llm/registry.py`.
DEEPINFRA_API_KEY=

# The model id the recommendations pass asks. **Measured, not assumed** — and
# measured on two axes, of which only the second decides the value below.
#
# * Latency (NEU-1100, `scripts/probe_deepinfra.py`, 2026-08-15): the ids finish
#   a trivial prompt within half a second of each other, while on the 522-show
#   account payload `deepseek-ai/DeepSeek-V4-Pro-0813` runs a 6.87s median
#   against `V4-Flash`'s 17.78s. That measurement stands; what it settles is how
#   long a pass takes, not which model can do the job.
# * Capacity (NEU-1180, `scripts/probe_deepinfra_capacity.py`, 2026-08-18): how
#   many of the 25 returned titles are *usable* — distinct, and not already
#   named in the payload — as the user's library grows. This is the axis that
#   actually binds, because latency ranks models that all work while capacity is
#   what stops working. Production ran `deepseek-ai/DeepSeek-V4-Flash-0731`,
#   which scores **0 usable at the 260-series library we already have**: every
#   suggestion was a series the user already had, §8's filter dropped all 25,
#   and the run recorded `no_matches` while the page kept serving last week's.
#
# `ByteDance/Seed-2.0-mini` scores 25 / 25 / 24 / 20 usable at 260 / 500 / 1000
# / 2000 series, for ~$0.04 per user per year. It is deliberately **not** the
# best complier on that curve — `ByteDance/Seed-2.0-pro` is — because pro's
# answers, read by a human against a real payload, were worse. A model change
# needs both halves: the automated curve, then one real payload's output read by
# eye.
#
# **It is slow, and the client's timeout was fitted to it rather than the other
# way round** (NEU-1180): 49.2s median / 57.0s max on a 522-row payload, against
# the 60s `retry.DEFAULT_RETRY_POLICY` then allowed — which is how both real
# production accounts came back `failed` on the first pass after the swap, four
# timed-out attempts apiece. That ceiling is now 150s. **Time a new id before
# setting it here**: `scripts/probe_deepinfra.py --model <id>` measures it at
# account scale, and the capacity sweep cannot, because it scores at
# `timeout=240` and would wave through a model the client will not wait for.
#
# `config.py` still defaults this to None, and should: a value here is the
# measurement's record and a deployment's starting point, while a default in
# code is a claim the client makes on every install, including after the id is
# retired upstream. **In production the value is set in the Coolify UI**, which
# seeds from a compose `${VAR:-default}` once and then shadows the file — so
# editing this file, or a compose fallback, changes nothing there.
RECOMMENDATION_MODEL=ByteDance/Seed-2.0-mini

# healthchecks.io deadman for the Coolify-scheduled TMDB catalog delta. Unset
# makes every ping a no-op, which is what local runs and tests want. One check
# per scheduled task, never one shared between them: either task feeding a
# shared check would keep it alive while the other quietly stopped running.
HEALTHCHECK_CATALOG_URL=

# The nightly airdate reconciliation's own deadman (NEU-1145). Its own, for the
# reason above: a check fed by both scheduled tasks would be kept alive by
# either one of them.
HEALTHCHECK_AIRDATE_URL=

# The weekly recommendations pass's own deadman (NEU-1111), pinged only by the
# whole-pass invocation — `--user <uuid>` narrows the run to one account and so
# says nothing about the schedule having fired. Weekly means a stopped schedule
# is invisible for seven days, which is the longest blind spot of the three.
HEALTHCHECK_RECOMMENDATIONS_URL=

# The daily trending snapshot's own deadman (NEU-1055). Its own, for the reason
# above — and this is the task whose silence is hardest to notice: a snapshot
# that stops being taken does not error, it ages out under the seven-day cutoff
# and the section simply disappears.
HEALTHCHECK_TRENDING_URL=

# scripts/refresh_db.sh — pull prod data into local tvbf via SSH + docker exec.
# Required:
#   PROD_SSH=user@host    SSH target where prod Postgres runs in a container.
# Optional overrides:
#   PROD_PG_USER          Defaults to the container's POSTGRES_USER env. Set
#                         this if your real user differs from POSTGRES_USER.
#   PROD_PG_DB            Defaults to the container's POSTGRES_DB env. Set this
#                         if the real database was created on top of the
#                         container's default DB (common with Coolify, where
#                         POSTGRES_DB=postgres and the app's DB is `tvbf`).
#   LOCAL_PG_CONTAINER=tbc_postgresql_db
#   LOCAL_DB=tvbf
#   LOCAL_DB_USER=root
#   ANONYMIZE=1           Set to 0 only for `both` mode when you need real prod app data.
#   ADMIN_EMAIL           If set, that user's email is preserved during anonymization
#                         so you can log in locally as your real prod identity. The
#                         password is still set to 'localdev'.
PROD_SSH=
PROD_PG_DB=tvbf
ADMIN_EMAIL=
